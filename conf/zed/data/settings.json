{
  "disable_ai": true,
  "base_keymap": "VSCode",
  "vim_mode": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 14,
  "format_on_save": "on",
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  "project_panel": {
    "dock": "left",
    "git_status": true
  },
  "restore_on_startup": "last_workspace",
  "terminal": {
    "font_family": "JetBrains Mono",
    "font_size": 13
  }
}
