{
  "name": "Omaconf vantablack",
  "author": "omaconf",
  "themes": [
    {
      "name": "Omaconf vantablack",
      "appearance": "dark",
      "style": {
        "background": "#000000",
        "surface.background": "#000000",
        "elevated_surface.background": "#1a1a1a",
        "panel.background": "#090909",
        "toolbar.background": "#000000",
        "title_bar.background": "#000000",
        "title_bar.inactive_background": "#000000",
        "status_bar.background": "#000000",
        "tab_bar.background": "#000000",
        "tab.active_background": "#000000",
        "tab.inactive_background": "#090909",
        "text": "#ffffff",
        "text.muted": "#7a7a7a",
        "text.accent": "#8d8d8d",
        "icon": "#ffffff",
        "icon.muted": "#7a7a7a",
        "icon.accent": "#8d8d8d",
        "border": "#7a7a7a",
        "border.focused": "#8d8d8d",
        "border.selected": "#8d8d8d",
        "element.background": "#000000",
        "element.hover": "#1a1a1a",
        "element.selected": "#1a1a1a",
        "element.active": "#1a1a1a",
        "editor.background": "#000000",
        "editor.foreground": "#ffffff",
        "editor.gutter.background": "#000000",
        "editor.line_number": "#7a7a7a",
        "editor.active_line_number": "#8d8d8d",
        "editor.active_line.background": "#1a1a1a",
        "editor.selection.background": "#1a1a1a",
        "editor.wrap_guide": "#7a7a7a",
        "players": [
          {
            "cursor": "#8d8d8d",
            "background": "#8d8d8d",
            "selection": "#1a1a1a"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#7a7a7a"
          },
          "keyword": {
            "color": "#9b9b9b"
          },
          "string": {
            "color": "#b6b6b6"
          },
          "number": {
            "color": "#b9b9b9"
          },
          "function": {
            "color": "#8d8d8d"
          },
          "type": {
            "color": "#cecece"
          },
          "variable": {
            "color": "#ffffff"
          },
          "constant": {
            "color": "#b0b0b0"
          },
          "operator": {
            "color": "#8d8d8d"
          }
        },
        "error": "#a4a4a4",
        "warning": "#cecece",
        "success": "#b6b6b6",
        "terminal.background": "#000000",
        "terminal.foreground": "#ffffff"
      }
    }
  ]
}
