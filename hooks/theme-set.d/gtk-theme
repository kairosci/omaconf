#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OMACONF_I18N_BOOT="${OMACONF_I18N_BOOT:-$SCRIPT_DIR/../i18n/i18n-boot.sh}"
[[ -f "$OMACONF_I18N_BOOT" ]] || OMACONF_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
source "$OMACONF_I18N_BOOT"

COLORS="${OMACONF_THEME_COLORS:-$HOME/.local/state/omarchy/current/theme/colors.toml}"
[[ -r "$COLORS" ]] || exit 0
palette() {
    awk -F '"' -v key="$1" '$1 ~ "^[[:space:]]*" key "[[:space:]]*=" { print $2; exit }' "$COLORS"
}
BACKGROUND="$(palette background)"
FOREGROUND="$(palette foreground)"
ACCENT="$(palette accent)"
SELECTION="$(palette selection)"
for color in "$BACKGROUND" "$FOREGROUND" "$ACCENT" "$SELECTION"; do
    [[ "$color" =~ ^#[0-9a-fA-F]{6}$ ]] || { warn "hooks.gtk_palette_failed" "$COLORS"; exit 1; }
done
MODE="$(palette mode)"
if [[ "$MODE" == light ]]; then
    GTK_THEME_NAME=Adwaita
    GTK_DARK=false
    GTK_ICONS=Papirus
else
    GTK_THEME_NAME=Adwaita-dark
    GTK_DARK=true
    GTK_ICONS=Papirus-Dark
fi

for version in 3 4; do
    config="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-$version.0"
    mkdir -p "$config"
    settings="$(mktemp "$config/.settings.XXXXXX")"
    if [[ -f "$config/settings.ini" ]]; then cat "$config/settings.ini" > "$settings"; fi
    temporary="$(mktemp "$config/.settings-new.XXXXXX")"
    awk -v theme="$GTK_THEME_NAME" -v dark="$GTK_DARK" -v icons="$GTK_ICONS" '
        function managed() {
            print "gtk-theme-name=" theme
            print "gtk-application-prefer-dark-theme=" dark
            print "gtk-icon-theme-name=" icons
            print "gtk-cursor-theme-name=capitaine-cursors"
        }
        /^\[Settings\]$/ { in_settings=1; found=1; print; managed(); next }
        /^\[/ { in_settings=0 }
        in_settings && /^gtk-(theme-name|application-prefer-dark-theme|icon-theme-name|cursor-theme-name)=/ { next }
        { print }
        END { if (!found) { print "[Settings]"; managed() } }
    ' "$settings" > "$temporary"
    chmod 644 "$temporary"
    mv -f "$temporary" "$config/settings.ini"
    rm -f "$settings"
    temporary="$(mktemp "$config/.omaconf.XXXXXX")"
    cat > "$temporary" <<EOF_CSS
@define-color theme_bg_color $BACKGROUND;
@define-color theme_base_color $BACKGROUND;
@define-color theme_fg_color $FOREGROUND;
@define-color theme_text_color $FOREGROUND;
@define-color theme_selected_bg_color $SELECTION;
@define-color theme_selected_fg_color $FOREGROUND;
@define-color accent_bg_color $ACCENT;
@define-color accent_color $ACCENT;
@define-color accent_fg_color $BACKGROUND;
window, dialog, .background, menubar, menu, menuitem, notebook, notebook header, notebook tab, viewport, scrolledwindow, stack, .view { background-color: $BACKGROUND; color: $FOREGROUND; }
headerbar, toolbar, .sidebar { background-color: $BACKGROUND; color: $FOREGROUND; }
view, treeview, iconview, textview, entry, button, list, row { background-color: $BACKGROUND; color: $FOREGROUND; }
view:selected, treeview:selected, iconview:selected, .view:selected, row:selected { background-color: $SELECTION; color: $FOREGROUND; }
EOF_CSS
    chmod 644 "$temporary"
    mv -f "$temporary" "$config/omaconf.css"
    if ! grep -qFx '@import url("omaconf.css");' "$config/gtk.css" 2>/dev/null; then
        temporary="$(mktemp "$config/.gtk.XXXXXX")"
        printf '%s\n' '@import url("omaconf.css");' > "$temporary"
        if [[ -f "$config/gtk.css" ]]; then cat "$config/gtk.css" >> "$temporary"; fi
        chmod 644 "$temporary"
        mv -f "$temporary" "$config/gtk.css"
    fi
done

GEANY_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/geany"
mkdir -p "$GEANY_CONFIG/colorschemes"
temporary="$(mktemp "$GEANY_CONFIG/colorschemes/.omaconf.XXXXXX")"
cat > "$temporary" <<EOF_GEANY
[theme_info]
name=Omarchy
[named_styles]
default=$FOREGROUND;$BACKGROUND;false;false
selection=$FOREGROUND;$SELECTION;false;true
current_line=$FOREGROUND;$SELECTION;false;false
caret=$FOREGROUND;$BACKGROUND;false;false
margin_linenumber=$FOREGROUND;$BACKGROUND;false;false
comment=$ACCENT;$BACKGROUND;false;true
number=$ACCENT;$BACKGROUND;false;false
string=$ACCENT;$BACKGROUND;false;false
keyword=$ACCENT;$BACKGROUND;true;false
keyword_1=$ACCENT;$BACKGROUND;true;false
function=$ACCENT;$BACKGROUND;false;false
type=$ACCENT;$BACKGROUND;false;false
EOF_GEANY
chmod 644 "$temporary"
mv -f "$temporary" "$GEANY_CONFIG/colorschemes/omaconf.conf"
if [[ ! -f "$GEANY_CONFIG/geany.conf" ]]; then
    printf '[geany]\ncolor_scheme=omaconf.conf\n' > "$GEANY_CONFIG/geany.conf"
elif grep -q '^color_scheme=' "$GEANY_CONFIG/geany.conf"; then
    sed -i 's/^color_scheme=.*/color_scheme=omaconf.conf/' "$GEANY_CONFIG/geany.conf"
elif grep -q '^\[geany\]' "$GEANY_CONFIG/geany.conf"; then
    sed -i '/^\[geany\]/a color_scheme=omaconf.conf' "$GEANY_CONFIG/geany.conf"
else
    printf '\n[geany]\ncolor_scheme=omaconf.conf\n' >> "$GEANY_CONFIG/geany.conf"
fi
