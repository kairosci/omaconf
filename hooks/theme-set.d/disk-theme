#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OMACONF_I18N_BOOT="${OMACONF_I18N_BOOT:-$SCRIPT_DIR/../i18n/i18n-boot.sh}"
[[ -f "$OMACONF_I18N_BOOT" ]] || OMACONF_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
if [[ -f "$OMACONF_I18N_BOOT" ]]; then
    . "$OMACONF_I18N_BOOT"
else
    warn() { printf '%s: %s\n' "Warning" "$1" >&2; }
fi

if [[ -f "$HOME/.local/state/omarchy/current/theme.name" ]]; then
    CURRENT_THEME=$(tr '[:upper:]' '[:lower:]' < "$HOME/.local/state/omarchy/current/theme.name" | tr ' ' '-')
else
    CURRENT_THEME="default"
fi
[[ -n "$CURRENT_THEME" ]] || CURRENT_THEME="default"
case "$CURRENT_THEME" in
    *..*|*/*) CURRENT_THEME="default" ;;
esac

DUA_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/dua-cli"
CONFIG_FILE="$DUA_CONFIG/config.toml"
MARK_BEGIN="# >>> omaconf disk theme >>>"
MARK_END="# <<< omaconf disk theme <<<"

mkdir -p "$DUA_CONFIG"

get_color() {
    local key="$1" default="$2" toml="$3"
    local val
    val=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$toml" 2>/dev/null | head -1 | sed -E 's/.*=[[:space:]]*"([^"]+)".*/\1/')
    if [[ "$val" =~ ^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$ ]]; then
        printf '%s\n' "$val"
    else
        printf '%s\n' "$default"
    fi
}

CURRENT_TOML="/usr/share/omarchy/themes/$CURRENT_THEME/colors.toml"
if [[ ! -f "$CURRENT_TOML" && -f "$HOME/.local/state/omarchy/current/theme/colors.toml" ]]; then
    CURRENT_TOML="$HOME/.local/state/omarchy/current/theme/colors.toml"
fi

if [[ -f "$CURRENT_TOML" ]]; then
    BG=$(get_color "background" "#1e1e2e" "$CURRENT_TOML")
    FG=$(get_color "foreground" "#cdd6f4" "$CURRENT_TOML")
    SELECTION=$(get_color "selection" "#45475a" "$CURRENT_TOML")
    MUTED=$(get_color "muted" "#585b70" "$CURRENT_TOML")
    ACCENT=$(get_color "accent" "#89b4fa" "$CURRENT_TOML")
else
    BG="#1e1e2e"
    FG="#cdd6f4"
    SELECTION="#45475a"
    MUTED="#585b70"
    ACCENT="#89b4fa"
fi

BLOCK_BODY="# omarchy-theme = \"$CURRENT_THEME\"
# palette: background=$BG foreground=$FG selection=$SELECTION muted=$MUTED accent=$ACCENT
# dua inherits the terminal palette; no color keys are forced."

STAGED="$(mktemp "$DUA_CONFIG/.config.toml.XXXXXX")" || exit 1
if [[ -f "$CONFIG_FILE" ]]; then
    awk -v begin="$MARK_BEGIN" -v end="$MARK_END" '
        index($0, begin) { skip = 1; next }
        skip && index($0, end) { skip = 0; next }
        skip { next }
        { body[++kept] = $0 }
        END {
            last = kept
            while (last > 0 && body[last] ~ /^[[:space:]]*$/) last--
            for (i = 1; i <= last; i++) print body[i]
        }
    ' "$CONFIG_FILE" > "$STAGED" || { rm -f "$STAGED"; exit 1; }
else
    : > "$STAGED"
fi
if [[ -s "$STAGED" ]]; then
    printf '\n' >> "$STAGED"
fi
printf '%s\n%s\n%s\n' "$MARK_BEGIN" "$BLOCK_BODY" "$MARK_END" >> "$STAGED"
if [[ -f "$CONFIG_FILE" ]] && cmp -s "$STAGED" "$CONFIG_FILE"; then
    rm -f "$STAGED"
else
    chmod 644 "$STAGED"
    mv "$STAGED" "$CONFIG_FILE"
fi
