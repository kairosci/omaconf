#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OMACONF_I18N_BOOT="${OMACONF_I18N_BOOT:-$SCRIPT_DIR/../i18n/i18n-boot.sh}"
[[ -f "$OMACONF_I18N_BOOT" ]] || OMACONF_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
source "$OMACONF_I18N_BOOT"

COLORS="${OMACONF_THEME_COLORS:-$HOME/.local/state/omarchy/current/theme/colors.toml}"
[[ -r "$COLORS" ]] || exit 0
ACCENT=$(awk -F '"' '/^accent[[:space:]]*=/ { print $2; exit }' "$COLORS")
[[ "$ACCENT" =~ ^#[0-9a-fA-F]{6}$ ]] || { warn "hooks.gtk_palette_failed" "$COLORS"; exit 1; }
MODE=$(awk -F '"' '/^mode[[:space:]]*=/ { print $2; exit }' "$COLORS")
if [[ "$MODE" == light ]]; then BASE=Papirus; else BASE=Papirus-Dark; fi
ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons/Omaconf-Papirus"
mkdir -p "$ICON_DIR"
printf '[Icon Theme]\nName=Omaconf Papirus\nInherits=%s,hicolor\nDirectories=16x16/places,22x22/places,24x24/places,32x32/places,48x48/places,64x64/places\n' "$BASE" > "$ICON_DIR/index.theme"
for size in 16 22 24 32 48 64; do
    directory="$ICON_DIR/${size}x${size}/places"
    mkdir -p "$directory"
    printf '\n[%sx%s/places]\nSize=%s\nContext=Places\nType=Fixed\n' "$size" "$size" "$size" >> "$ICON_DIR/index.theme"
    for source in /usr/share/icons/Papirus/"${size}x${size}"/places/folder-blue*.svg; do
        [[ -f "$source" ]] || continue
        name="${source##*/}"
        name="${name/folder-blue/folder}"
        sed -e "s/#5294e2/$ACCENT/gi" -e "s/#4877b1/$ACCENT/gi" "$source" > "$directory/$name"
    done
    if [[ -f "$directory/folder.svg" ]]; then ln -sfn folder.svg "$directory/inode-directory.svg"; fi
done
if command -v gtk-update-icon-cache >/dev/null; then gtk-update-icon-cache -q -f -t "$ICON_DIR"; fi
