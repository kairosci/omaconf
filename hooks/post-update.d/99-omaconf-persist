#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OMACONF_I18N_BOOT="${OMACONF_I18N_BOOT:-$SCRIPT_DIR/../i18n/i18n-boot.sh}"
[[ -f "$OMACONF_I18N_BOOT" ]] || OMACONF_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
if [[ -f "$OMACONF_I18N_BOOT" ]]; then
    . "$OMACONF_I18N_BOOT"
else
    warn() { printf '%s: %s\n' "Warning" "$1" >&2; }
fi
OMACONF_OS_IDENTITY=/usr/local/lib/omaconf/os-identity.sh
if [[ $EUID -eq 0 && -r "$OMACONF_OS_IDENTITY" ]]; then
    source "$OMACONF_OS_IDENTITY"
    arch_identity_apply || { warn "identity.failed"; exit 1; }
fi
run_as_user() {
  local _ru="$1"
  shift
  if [[ "$_ru" == "$(id -un 2>/dev/null)" ]]; then
    "$@" 2>/dev/null || return 1
  else
    sudo -u "$_ru" "$@" 2>/dev/null || return 1
  fi
}
OMACONF_DESKTOP_WORKFLOW="${OMACONF_DESKTOP_WORKFLOW:-$SCRIPT_DIR/../lib/desktop-workflow.sh}"
[[ -f "$OMACONF_DESKTOP_WORKFLOW" ]] || OMACONF_DESKTOP_WORKFLOW="$SCRIPT_DIR/../../scripts/lib/desktop-workflow.sh"
source "$OMACONF_DESKTOP_WORKFLOW"
DESKTOP_WORKFLOW_PORTALS="$SCRIPT_DIR/../lib/portals.conf"
[[ -f "$DESKTOP_WORKFLOW_PORTALS" ]] || DESKTOP_WORKFLOW_PORTALS="$SCRIPT_DIR/../../conf/xdg-desktop-portal/data/portals.conf"
user_as() {
    local user="$1" uid home
    shift
    uid=$(id -u "$user") || return 1
    home=$(getent passwd "$user" | cut -d: -f6) || return 1
    run_as_user "$user" env "HOME=$home" "XDG_RUNTIME_DIR=/run/user/$uid" \
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" "$@"
}
OMACONF_THEME_PREVIEW="${OMACONF_THEME_PREVIEW:-$SCRIPT_DIR/../lib/theme-preview.sh}"
[[ -f "$OMACONF_THEME_PREVIEW" ]] || OMACONF_THEME_PREVIEW="$SCRIPT_DIR/../../scripts/lib/theme-preview.sh"
if [[ -f "$OMACONF_THEME_PREVIEW" ]]; then
  source "$OMACONF_THEME_PREVIEW"
fi
if declare -F theme_preview_normalize >/dev/null; then
  if [[ $EUID -eq 0 ]]; then
    theme_preview_normalize || warn "hooks.preview_size_reapply_skipped"
  else
    warn "hooks.preview_size_reapply_root_skipped"
  fi
fi
PIN_FILES=("/etc/pacman.d/omaconf/ignore-pkgs.list")
PINS=""
for PIN_FILE in "${PIN_FILES[@]}"; do
  [[ -f "$PIN_FILE" ]] || continue
  PINS="$PINS $(tr '\n' ' ' < "$PIN_FILE" | xargs)"
done
PINS=$(printf '%s\n' "$PINS" | xargs)
if [[ -n "$PINS" ]]; then
  EXISTING=""
  if grep -q '^IgnorePkg' /etc/pacman.conf 2>/dev/null; then
    EXISTING=$(grep '^IgnorePkg' /etc/pacman.conf | head -1 | sed 's/^IgnorePkg[[:space:]]*=[[:space:]]*//')
  fi
  MERGED="$EXISTING"
  for pkg in $PINS; do
    grep -qw "$pkg" <<< " $MERGED " 2>/dev/null || MERGED="$MERGED $pkg"
  done
  MERGED=$(printf '%s\n' "$MERGED" | xargs)
  if [[ "$MERGED" != "$EXISTING" ]]; then
    if grep -q '^IgnorePkg' /etc/pacman.conf 2>/dev/null; then
      if [[ $EUID -eq 0 ]]; then
        sed -i "s|^IgnorePkg.*|IgnorePkg = $MERGED|" /etc/pacman.conf 2>/dev/null || warn "hooks.ignore_merge_skipped"
      elif sudo -n true 2>/dev/null; then
        sudo -n sed -i "s|^IgnorePkg.*|IgnorePkg = $MERGED|" /etc/pacman.conf 2>/dev/null || warn "hooks.ignore_merge_skipped"
      else
        warn "hooks.ignore_merge_root_skipped"
      fi
    else
      if [[ $EUID -eq 0 ]]; then
        sed -i "/^\\[options\\]/a IgnorePkg = $MERGED" /etc/pacman.conf 2>/dev/null || warn "hooks.ignore_insert_skipped"
      elif sudo -n true 2>/dev/null; then
        sudo -n sed -i "/^\\[options\\]/a IgnorePkg = $MERGED" /etc/pacman.conf 2>/dev/null || warn "hooks.ignore_insert_skipped"
      else
        warn "hooks.ignore_insert_root_skipped"
      fi
    fi
  fi
  read -ra PINNED <<< "$PINS"
  INSTALLED=()
  for pkg in "${PINNED[@]}"; do
    if pacman -Qq "$pkg" 2>/dev/null | grep -qx "$pkg"; then
      INSTALLED+=("$pkg")
    fi
  done
  if [[ ${#INSTALLED[@]} -gt 0 ]]; then
    if [[ $EUID -eq 0 ]]; then
      pacman -Rns --noconfirm "${INSTALLED[@]}" 2>/dev/null || warn "hooks.debloat_reapply_skipped"
    elif sudo -n true 2>/dev/null; then
      sudo -n pacman -Rns --noconfirm "${INSTALLED[@]}" 2>/dev/null || warn "hooks.debloat_reapply_skipped"
    else
      warn "hooks.debloat_reapply_root_skipped"
    fi
  fi
fi
if [[ -x /usr/local/libexec/omaconf-desktop-cleanup ]]; then
  /usr/local/libexec/omaconf-desktop-cleanup 2>/dev/null || warn "hooks.desktop_reapply_skipped" "all"
elif [[ -x "$SCRIPT_DIR/../../scripts/lib/desktop-cleanup.sh" ]]; then
  "$SCRIPT_DIR/../../scripts/lib/desktop-cleanup.sh" 2>/dev/null || warn "hooks.desktop_reapply_skipped" "all"
fi
for user_home in /home/*; do
  [[ -d "$user_home" ]] || continue
  _user=$(basename "$user_home")
  _uid=$(id -u "$_user" 2>/dev/null) || continue
  if [[ -e "/run/user/$_uid/bus" ]]; then
    run_as_user "$_user" env XDG_RUNTIME_DIR="/run/user/$_uid" gsettings set org.gnome.desktop.interface cursor-theme "capitaine-cursors" 2>/dev/null || warn "hooks.cursor_reapply_skipped" "$_user"
  fi
  if [[ -n "$_uid" && -d "/run/user/$_uid" ]]; then
    _user_env=(env "XDG_RUNTIME_DIR=/run/user/$_uid" "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$_uid/bus")
    run_as_user "$_user" "${_user_env[@]}" systemctl --user disable --now omarchy-crash-watch.service 2>/dev/null || warn "hooks.crashwatch_disable_skipped" "$_user"
    run_as_user "$_user" "${_user_env[@]}" systemctl --user mask omarchy-crash-watch.service 2>/dev/null || warn "hooks.crashwatch_mask_skipped" "$_user"
  fi
  desktop_workflow_defaults "$_user" "$user_home" || warn "hooks.desktop_reapply_skipped" "$_user"
  desktop_workflow_portals "$_user" "$user_home" || warn "hooks.portal_reload_skipped" "$_user"
  for _hook in folder-color gtk-theme shell-icons; do
    _hook_path="$user_home/.config/omarchy/hooks/theme-set.d/$_hook"
    if [[ -f "$_hook_path" ]]; then
      user_as "$_user" bash "$_hook_path" || warn "hooks.icons_reapply_skipped" "$_user"
    fi
  done
done
