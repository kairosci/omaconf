#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OMACONF_I18N_BOOT="${OMACONF_I18N_BOOT:-$SCRIPT_DIR/../i18n/i18n-boot.sh}"
[[ -f "$OMACONF_I18N_BOOT" ]] || OMACONF_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
if [[ -f "$OMACONF_I18N_BOOT" ]]; then
    . "$OMACONF_I18N_BOOT"
else
    warn() { printf '%s: %s\n' "Warning" "$1" >&2; }
fi
PIN_FILE="${OMACONF_PIN_FILE:-/etc/pacman.d/omaconf/ignore-pkgs.list}"
[[ -f "$PIN_FILE" ]] || exit 0
PINS=$(pacman-conf IgnorePkg)
while IFS= read -r pkg || [[ -n "$pkg" ]]; do
    [[ -n "$pkg" ]] || continue
    if ! grep -Fxq -- "$pkg" <<< "$PINS"; then
        warn "hooks.ignore_merge_root_skipped"
        exit 1
    fi
done < "$PIN_FILE"
