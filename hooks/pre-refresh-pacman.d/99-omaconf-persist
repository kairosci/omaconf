#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OMACONF_I18N_BOOT="${OMACONF_I18N_BOOT:-$SCRIPT_DIR/../i18n/i18n-boot.sh}"
[[ -f "$OMACONF_I18N_BOOT" ]] || OMACONF_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
if [[ -f "$OMACONF_I18N_BOOT" ]]; then
    . "$OMACONF_I18N_BOOT"
else
    warn() { printf '%s: %s\n' "Warning" "$1" >&2; }
fi
PIN_FILES=("/etc/pacman.d/omaconf/ignore-pkgs.list" "/etc/pacman.d/omasec/ignore-pkgs.list")
PINS=""
for PIN_FILE in "${PIN_FILES[@]}"; do
  [[ -f "$PIN_FILE" ]] || continue
  PINS="$PINS $(tr '\n' ' ' < "$PIN_FILE" | xargs)"
done
PINS=$(printf '%s\n' "$PINS" | xargs)
[[ -n "$PINS" ]] || exit 0
EXISTING=""
if grep -q '^IgnorePkg' /etc/pacman.conf 2>/dev/null; then
  EXISTING=$(grep '^IgnorePkg' /etc/pacman.conf | head -1 | sed 's/^IgnorePkg[[:space:]]*=[[:space:]]*//')
fi
MERGED="$EXISTING"
for pkg in $PINS; do
  grep -qw "$pkg" <<< " $MERGED " 2>/dev/null || MERGED="$MERGED $pkg"
done
MERGED=$(printf '%s\n' "$MERGED" | xargs)
[[ "$MERGED" == "$EXISTING" ]] && exit 0
if grep -q '^IgnorePkg' /etc/pacman.conf 2>/dev/null; then
  if [[ $EUID -eq 0 ]]; then
    sed -i "s|^IgnorePkg.*|IgnorePkg = $MERGED|" /etc/pacman.conf 2>/dev/null || warn "hooks.ignore_merge_skipped"
  elif sudo -n true 2>/dev/null; then
    sudo -n sed -i "s|^IgnorePkg.*|IgnorePkg = $MERGED|" /etc/pacman.conf 2>/dev/null || warn "hooks.ignore_merge_skipped"
  else
    warn "hooks.ignore_merge_root_skipped"
  fi
else
  if [[ $EUID -eq 0 ]]; then
    sed -i "/^\\[options\\]/a IgnorePkg = $MERGED" /etc/pacman.conf 2>/dev/null || warn "hooks.ignore_insert_skipped"
  elif sudo -n true 2>/dev/null; then
    sudo -n sed -i "/^\\[options\\]/a IgnorePkg = $MERGED" /etc/pacman.conf 2>/dev/null || warn "hooks.ignore_insert_skipped"
  else
    warn "hooks.ignore_insert_root_skipped"
  fi
fi
