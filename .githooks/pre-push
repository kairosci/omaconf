#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(git rev-parse --show-toplevel)"
source "$PROJECT_DIR/scripts/lib/i18n.sh"
i18n_init
while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == refs/heads/main ]]; then
        err "git.main_push_forbidden"
    fi
done
