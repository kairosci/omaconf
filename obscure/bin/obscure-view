#!/bin/bash
set -euo pipefail

log() { printf '%s\n' "$1"; }
warn() { printf '%s\n' "warning: $1"; }
err() { printf '%s\n' "error: $1"; exit 1; }

prompt_password() {
    if [[ -n "${OBSCURE_PASSWORD:-}" ]]; then
        printf '%s' "$OBSCURE_PASSWORD"
        return 0
    fi
    if command -v systemd-ask-password &>/dev/null; then
        systemd-ask-password "system login password" 2>/dev/null && return 0
    fi
    if [[ -r /dev/tty ]]; then
        local pw=""
        read -r -s -p "system login password: " pw < /dev/tty
        printf '\n' > /dev/tty 2>/dev/null || printf '\n'
        printf '%s' "$pw"
        return 0
    fi
    return 1
}

verify_os_password() {
    local given="$1"
    printf '%s\n' "$given" | sudo -S -v 2>/dev/null || return 1
    sudo -k 2>/dev/null || warn "sudo timestamp reset skipped"
    return 0
}

is_text() {
    local target="$1"
    local mime=""
    mime=$(file -b --mime-type "$target" 2>/dev/null) || return 1
    case "$mime" in
        text/*|application/json|application/xml|inode/empty) return 0 ;;
        *) return 1 ;;
    esac
}

is_pdf() {
    local target="$1"
    local mime=""
    mime=$(file -b --mime-type "$target" 2>/dev/null) || return 1
    case "$mime" in
        application/pdf|application/x-pdf) return 0 ;;
        *)
            [[ "$target" == *.pdf || "$target" == *.PDF ]] && return 0
            return 1
            ;;
    esac
}

[[ $# -ge 1 ]] || err "usage: obscure-view <file> [...]"
command -v sudo &>/dev/null || err "sudo required to verify the system login password"

given="$(prompt_password)" || err "password prompt failed"
[[ -n "$given" ]] || err "empty password refused"
verify_os_password "$given" || err "wrong system password"
unset given

PAGER_BIN="${PAGER:-less}"
for target in "$@"; do
    [[ -f "$target" ]] || { warn "not a file: $target"; continue; }
    if is_text "$target"; then
        "$PAGER_BIN" "$target" 2>/dev/null || warn "pager skipped for $target"
    elif is_pdf "$target"; then
        if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]] && command -v mupdf &>/dev/null; then
            (setsid mupdf "$target" >/dev/null 2>&1 &) || xdg-open "$target" 2>/dev/null || warn "pdf viewer skipped for $target"
        elif command -v pdftotext &>/dev/null; then
            pdftotext "$target" - 2>/dev/null | "$PAGER_BIN" || xdg-open "$target" 2>/dev/null || warn "pdf viewer skipped for $target"
        elif command -v mupdf &>/dev/null; then
            (setsid mupdf "$target" >/dev/null 2>&1 &) || xdg-open "$target" 2>/dev/null || warn "pdf viewer skipped for $target"
        else
            xdg-open "$target" 2>/dev/null || warn "open skipped for $target"
        fi
    else
        xdg-open "$target" 2>/dev/null || warn "open skipped for $target"
    fi
done
